!! @wrapper

>>

_meta charset="UTF-8"
_meta name="viewport" content="width=device-width, initial-scale=1.0"
_title
  Lumina Psicologia
_link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"


##

*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --sage: #8BA888;
  --sage-light: #C4D4C2;
  --sage-pale: #EEF3ED;
  --cream: #F7F3EE;
  --clay: #C4956A;
  --clay-light: #E8C9A8;
  --text-dark: #2C2C2A;
  --text-mid: #5F5E5A;
  --text-light: #888780;
  --white: #FFFFFF;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--cream);
  color: var(--text-dark);
  overflow-x: hidden;
}

/* NAV */
nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 5rem;
  background: rgba(247, 243, 238, 0.94);
  backdrop-filter: blur(14px);
  border-bottom: 0.5px solid rgba(139, 168, 136, 0.2);
}

.nav-logo {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.55rem;
  font-weight: 400;
  color: var(--text-dark);
  letter-spacing: 0.04em;
  text-decoration: none;
}

.nav-logo span {
  color: var(--sage);
  font-style: italic;
}

.nav-links {
  display: flex;
  gap: 2.5rem;
  list-style: none;
  align-items: center;
}

.nav-links a {
  text-decoration: none;
  font-size: 0.82rem;
  font-weight: 400;
  color: var(--text-mid);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  transition: color 0.3s;
}

.nav-links a:hover {
  color: var(--sage);
}

.nav-cta {
  background: var(--sage) !important;
  color: var(--white) !important;
  padding: 0.55rem 1.5rem !important;
  border-radius: 2rem;
  transition: background 0.3s, transform 0.2s !important;
  letter-spacing: 0.04em !important;
}

.nav-cta:hover {
  background: #6a9668 !important;
  transform: translateY(-1px);
}

/* HERO */
.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding-top: 5rem;
}

.hero-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 6rem 3rem 6rem 5rem;
  animation: fadeUp 0.9s ease both;
}

.hero-tag {
  display: inline-block;
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--clay);
  font-weight: 500;
  margin-bottom: 1.75rem;
  padding: 0.4rem 1.1rem;
  background: var(--clay-light);
  border-radius: 2rem;
  width: fit-content;
}

.hero-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2.8rem, 4.5vw, 4.2rem);
  font-weight: 300;
  line-height: 1.1;
  color: var(--text-dark);
  margin-bottom: 1.5rem;
}

.hero-title em {
  font-style: italic;
  color: var(--sage);
}

.hero-subtitle {
  font-size: 1rem;
  line-height: 1.85;
  color: var(--text-mid);
  max-width: 420px;
  margin-bottom: 2.75rem;
  font-weight: 300;
}

.hero-buttons {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.btn-primary {
  background: var(--sage);
  color: var(--white);
  border: none;
  padding: 0.9rem 2.2rem;
  border-radius: 3rem;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s;
  letter-spacing: 0.02em;
  animation: pulseGlow 3s ease-in-out 2s infinite;
}

.btn-primary:hover {
  background: #6a9668;
  transform: translateY(-2px);
}

.btn-secondary {
  background: transparent;
  color: var(--text-dark);
  border: 1px solid rgba(44, 44, 42, 0.22);
  padding: 0.9rem 2.2rem;
  border-radius: 3rem;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.9rem;
  font-weight: 400;
  cursor: pointer;
  transition: all 0.3s;
}

.btn-secondary:hover {
  border-color: var(--sage);
  color: var(--sage);
  transform: translateY(-2px);
}

.hero-right {
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.9s ease 0.2s both;
}

.hero-visual {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, var(--sage-pale) 0%, var(--sage-light) 55%, #7aad77 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
  opacity: 0.18;
}

.blob-1 {
  width: 420px;
  height: 420px;
  background: var(--clay);
  top: -120px;
  right: -120px;
}

.blob-2 {
  width: 260px;
  height: 260px;
  background: var(--white);
  bottom: 80px;
  left: 30px;
}

.hero-center {
  position: relative;
  z-index: 2;
  text-align: center;
}

.hero-ring {
  width: 290px;
  height: 290px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  border: 1.5px solid rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  backdrop-filter: blur(6px);
}

.float-card {
  position: absolute;
  background: var(--white);
  border-radius: 1.25rem;
  padding: 0.9rem 1.4rem;
  display: flex;
  align-items: center;
  gap: 0.65rem;
  box-shadow: 0 10px 40px rgba(44, 44, 42, 0.1);
}

.fc-right {
  bottom: 90px;
  right: 28px;
}

.fc-left {
  top: 130px;
  left: 18px;
}

.fc-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  flex-shrink: 0;
}

.fc-title {
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--text-dark);
}

.fc-sub {
  font-size: 0.68rem;
  color: var(--text-light);
  margin-top: 1px;
}

/* STATS */
.stats {
  background: var(--text-dark);
  padding: 3rem 5rem;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  text-align: center;
}

.stat-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 3rem;
  font-weight: 300;
  color: var(--sage-light);
  line-height: 1;
}

.stat-label {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 0.45rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

/* SECTIONS */
section {
  padding: 7rem 5rem;
}

.sec-tag {
  font-size: 0.7rem;
  letter-spacing: 0.17em;
  text-transform: uppercase;
  color: var(--clay);
  font-weight: 500;
  margin-bottom: 0.9rem;
}

.sec-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  font-weight: 300;
  line-height: 1.2;
  color: var(--text-dark);
  max-width: 480px;
  margin-bottom: 3.5rem;
}

.sec-title em {
  font-style: italic;
  color: var(--sage);
}

/* CARDS */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.card {
  background: var(--white);
  border-radius: 1.5rem;
  padding: 2.5rem 2rem;
  border: 0.5px solid rgba(139, 168, 136, 0.2);
  transition: transform 0.3s, box-shadow 0.3s;
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 22px 50px rgba(44, 44, 42, 0.07);
}

.card-icon {
  width: 52px;
  height: 52px;
  border-radius: 1rem;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.3rem;
  font-weight: 400;
  color: var(--text-dark);
  margin-bottom: 0.7rem;
}

.card-text {
  font-size: 0.87rem;
  line-height: 1.8;
  color: var(--text-mid);
  font-weight: 300;
}

/* ABOUT */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: center;
  background: var(--sage-pale);
  padding: 7rem 5rem;
}

.about-frame {
  width: 100%;
  aspect-ratio: 3/4;
  background: linear-gradient(160deg, var(--sage-light), #7aad77);
  border-radius: 2rem;
  position: relative;
  overflow: hidden;
}

.about-frame::before {
  content: '';
  position: absolute;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  top: -50px;
  right: -50px;
}

.about-quote {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 3rem 2.5rem;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.35), transparent);
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.45rem;
  font-weight: 300;
  color: white;
  line-height: 1.35;
}

.about-badge {
  position: absolute;
  bottom: -20px;
  right: -20px;
  background: var(--white);
  border-radius: 1.25rem;
  padding: 1.2rem 1.5rem;
  box-shadow: 0 10px 40px rgba(44, 44, 42, 0.1);
}

.badge-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2rem;
  font-weight: 300;
  color: var(--sage);
  line-height: 1;
}

.badge-sub {
  font-size: 0.72rem;
  color: var(--text-mid);
  margin-top: 0.2rem;
}

.about-desc {
  font-size: 0.93rem;
  line-height: 1.9;
  color: var(--text-mid);
  font-weight: 300;
  margin-bottom: 1.25rem;
}

.creds {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  margin-top: 1.75rem;
}

.cred {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.85rem;
  color: var(--text-mid);
}

.cred-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--sage);
  flex-shrink: 0;
}

/* TESTIMONIALS */
.test-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.75rem;
  margin-top: 3.5rem;
}

.test-card {
  background: var(--cream);
  border-radius: 1.5rem;
  padding: 2.5rem;
  border: 0.5px solid rgba(139, 168, 136, 0.15);
}

.test-card-white {
  background: var(--white);
}

.test-quote {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.1rem;
  font-style: italic;
  line-height: 1.75;
  color: var(--text-dark);
  margin-bottom: 1.5rem;
}

.test-quote::before {
  content: '\201C';
  font-size: 2.5rem;
  color: var(--sage-light);
  line-height: 0;
  vertical-align: -0.55em;
  margin-right: 0.15em;
}

.test-name {
  font-size: 0.83rem;
  font-weight: 500;
  color: var(--text-dark);
}

.test-role {
  font-size: 0.74rem;
  color: var(--text-light);
  margin-top: 0.2rem;
}

/* BOOKING */
.booking {
  background: var(--sage);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.booking::before {
  content: '';
  position: absolute;
  width: 520px;
  height: 520px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  top: -220px;
  left: -120px;
}

.booking::after {
  content: '';
  position: absolute;
  width: 380px;
  height: 380px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  bottom: -180px;
  right: -60px;
}

.booking-inner {
  position: relative;
  z-index: 2;
}

.booking-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 300;
  color: var(--white);
  margin-bottom: 1rem;
  line-height: 1.25;
}

.booking-sub {
  font-size: 0.95rem;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 300;
  margin-bottom: 3rem;
  max-width: 460px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.75;
}

.booking-btns {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.btn-white {
  background: var(--white);
  color: var(--sage);
  border: none;
  padding: 0.95rem 2.4rem;
  border-radius: 3rem;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s;
}

.btn-white:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(44, 44, 42, 0.15);
}

.btn-outline-white {
  background: transparent;
  color: var(--white);
  border: 1px solid rgba(255, 255, 255, 0.45);
  padding: 0.95rem 2.4rem;
  border-radius: 3rem;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.9rem;
  font-weight: 400;
  cursor: pointer;
  transition: all 0.3s;
}

.btn-outline-white:hover {
  border-color: var(--white);
  transform: translateY(-2px);
}

/* FOOTER */
footer {
  background: var(--text-dark);
  padding: 2.75rem 5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.25rem;
}

.footer-logo {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.3rem;
  font-weight: 300;
  color: var(--sage-light);
  font-style: italic;
}

.footer-links {
  display: flex;
  gap: 2rem;
  list-style: none;
  flex-wrap: wrap;
}

.footer-links a {
  text-decoration: none;
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  transition: color 0.3s;
}

.footer-links a:hover {
  color: var(--sage-light);
}

.footer-copy {
  font-size: 0.72rem;
  color: rgba(255, 255, 255, 0.25);
}

/* ANIMATIONS */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(28px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulseGlow {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(139, 168, 136, 0.35);
  }

  50% {
    box-shadow: 0 0 0 14px rgba(139, 168, 136, 0);
  }
}

/* RESPONSIVE */
@media (max-width: 900px) {
  nav {
    padding: 1.1rem 2rem;
  }

  .nav-links {
    gap: 1.5rem;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .hero-right {
    min-height: 55vw;
  }

  .hero-left {
    padding: 4rem 2rem 3rem;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
    padding: 2.5rem 2rem;
  }

  section {
    padding: 5rem 2rem;
  }

  .cards-grid {
    grid-template-columns: 1fr;
  }

  .about-grid {
    grid-template-columns: 1fr;
    padding: 5rem 2rem;
    gap: 3rem;
  }

  .test-grid {
    grid-template-columns: 1fr;
  }

  footer {
    padding: 2rem;
    flex-direction: column;
    align-items: flex-start;
  }
}

