let currentLang = 'pt';

function t(key){ return (i18n[currentLang]||i18n.pt)[key] || key; }

function setLang(lang){
  currentLang = lang;
  document.documentElement.lang = lang;
  document.querySelectorAll('.lang-opt').forEach(b=>b.classList.toggle('active', b.textContent===lang.toUpperCase()));
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const key = el.dataset.i18n;
    el.textContent = t(key);
  });
  renderFleet();
  renderReviews();
}

/* ─── FLEET DATA ─── */
const fleet = [
  {id:1,emoji:'🚗',name:'Hyundai HB20',sub:'Hatch 2024',category:'economy',price:149,color:'#E8F4FD',trans:'Auto',doors:4,people:5,available:true},
  {id:2,emoji:'🚙',name:'Toyota SW4',sub:'SUV 7 lugares',category:'suv',price:390,color:'#FDF5E8',trans:'Auto',doors:4,people:7,available:true},
  {id:3,emoji:'🏎️',name:'BMW Série 5',sub:'Sedan Executive',category:'luxury',price:680,color:'#E8ECF5',trans:'Auto',doors:4,people:5,available:true},
  {id:4,emoji:'⚡',name:'BYD Han EV',sub:'Elétrico 100%',category:'electric',price:520,color:'#E8F9F0',trans:'Auto',doors:4,people:5,available:true},
  {id:5,emoji:'🚘',name:'Chevrolet Onix',sub:'Sedan 2024',category:'economy',price:169,color:'#F5E8FD',trans:'Manual',doors:4,people:5,available:false},
  {id:6,emoji:'🛻',name:'Toyota Hilux',sub:'Pick-up 4x4',category:'suv',price:450,color:'#FDE8E8',trans:'Auto',doors:4,people:5,available:true},
  {id:7,emoji:'🚗',name:'Mercedes GLE',sub:'SUV Luxo',category:'luxury',price:890,color:'#E8EBF5',trans:'Auto',doors:4,people:5,available:true},
  {id:8,emoji:'⚡',name:'Tesla Model 3',sub:'Elétrico Premium',category:'electric',price:620,color:'#E8FDF5',trans:'Auto',doors:4,people:5,available:true},
];

let currentCar = null;
let currentFilter = 'all';

function renderFleet(){
  const grid = document.getElementById('fleetGrid');
  const filtered = currentFilter==='all' ? fleet : fleet.filter(c=>c.category===currentFilter);
  grid.innerHTML = filtered.map(car => `
    <div class="car-card reveal" onclick="openModal(${car.id})">
      <div class="car-img" style="background:${car.color||'#F5F7FC'};">
        <span class="car-img-badge">${t('cat.'+car.category)}</span>
        <span class="car-img-avail ${car.available?'avail-yes':'avail-no'}">${car.available?t('card.available'):t('card.unavailable')}</span>
        <span style="font-size:5.5rem;filter:drop-shadow(2px 4px 8px rgba(0,0,0,.15));">${car.emoji}</span>
      </div>
      <div class="car-body">
        <div class="car-top">
          <div>
            <div class="car-name">${car.name}</div>
            <div class="car-sub">${car.sub}</div>
          </div>
          <div class="car-pricing">
            <div class="car-price">R$ ${car.price}</div>
            <div class="car-per">${t('card.per_day')}</div>
          </div>
        </div>
        <div class="car-specs">
          <span class="spec">⚙️ ${car.trans}</span>
          <span class="spec">🚪 ${car.doors} ${t('card.doors')}</span>
          <span class="spec">👥 ${car.people} ${t('card.people')}</span>
        </div>
        <div class="car-actions">
          <button class="btn-reserve" onclick="event.stopPropagation();openModal(${car.id})" ${!car.available?'disabled style="opacity:.5;cursor:not-allowed;"':''}>
            ${t('card.reserve')}
          </button>
          <button class="btn-info" onclick="event.stopPropagation();openModal(${car.id})">ℹ️</button>
        </div>
      </div>
    </div>
  `).join('');
  observeReveal();
}

function filterFleet(cat, btn){
  currentFilter = cat;
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderFleet();
}

/* ─── REVIEWS ─── */
const reviews = [
  {name:'Ana Beatriz',loc:'Belém, PA',avatar:'AB',stars:5,pt:'Serviço impecável! Reservei pelo site e o carro estava exatamente como descrito. Voltarei com certeza!',en:'Impeccable service! I booked online and the car was exactly as described. I will definitely return!',es:'¡Servicio impecable! Reservé en línea y el auto era exactamente como se describió. ¡Volveré sin duda!'},
  {name:'Carlos Mendes',loc:'Manaus, AM',avatar:'CM',stars:5,pt:'Fantástico! Aluguel da Hilux para trilha na Amazônia. Carro perfeito, entrega pontual e preço honesto.',en:'Fantastic! Rented the Hilux for an Amazon trail. Perfect car, on-time delivery and honest price.',es:'¡Fantástico! Alquilé la Hilux para un sendero amazónico. Auto perfecto, entrega puntual y precio justo.'},
  {name:'Marie Dupont',loc:'Paris, France',avatar:'MD',stars:5,pt:'Como turista, ficou fácil reservar em inglês. Atendimento excelente e carro luxuoso. Recomendo muito!',en:'As a tourist, it was easy to book in English. Excellent service and luxurious car. Highly recommend!',es:'Como turista, fue fácil reservar en inglés. ¡Excelente servicio y auto lujoso. Lo recomiendo mucho!'},
  {name:'Roberto Silva',loc:'São Paulo, SP',avatar:'RS',stars:5,pt:'Vim a trabalho e precisava de um carro confortável. A DriveNow superou todas as expectativas! 10/10.',en:'I came for work and needed a comfortable car. DriveNow exceeded all expectations! 10/10.',es:'Vine por trabajo y necesitaba un auto cómodo. ¡DriveNow superó todas las expectativas! 10/10.'},
  {name:'Luisa García',loc:'Buenos Aires, ARG',avatar:'LG',stars:5,pt:'Site em espanhol facilitou muito! Processo de reserva simples e rápido. Carro elétrico incrível.',en:'Website in Spanish made it much easier! Simple and fast booking process. Amazing electric car.',es:'¡El sitio en español facilitó mucho! Proceso de reserva simple y rápido. Auto eléctrico increíble.'},
  {name:'Pedro Alves',loc:'Macapá, AP',avatar:'PA',stars:5,pt:'Melhor locadora da cidade! Frotas novas, preços justos e atendimento humanizado. Recomendo!',en:'Best rental in the city! New fleet, fair prices and human service. I recommend!',es:'¡La mejor arrendadora de la ciudad! Flota nueva, precios justos y atención humana. ¡Lo recomiendo!'},
];

function renderReviews(){
  document.getElementById('reviewsGrid').innerHTML = reviews.map(r=>`
    <div class="review-card reveal">
      <div class="stars">${'★'.repeat(r.stars)}</div>
      <p class="review-text">"${r[currentLang]||r.pt}"</p>
      <div class="reviewer">
        <div class="reviewer-avatar">${r.avatar}</div>
        <div>
          <div class="reviewer-name">${r.name}</div>
          <div class="reviewer-loc">📍 ${r.loc}</div>
        </div>
      </div>
    </div>
  `).join('');
  observeReveal();
}

/* ─── MODAL ─── */
function openModal(id){
  const car = fleet.find(c=>c.id===id);
  if(!car) return;
  currentCar = car;
  document.getElementById('modalTitle').textContent = t('modal.title') + ' – ' + car.name;

  const today = new Date().toISOString().split('T')[0];
  const tomorrow = new Date(Date.now()+86400000).toISOString().split('T')[0];
  document.getElementById('fPickup').value = document.getElementById('barPickup').value || today;
  document.getElementById('fReturn').value  = document.getElementById('barReturn').value  || tomorrow;

  document.getElementById('modalCarPreview').innerHTML = `
    <span style="font-size:2.8rem">${car.emoji}</span>
    <div class="modal-car-info">
      <div class="car-name">${car.name}</div>
      <div class="car-sub">${car.sub}</div>
    </div>
    <div class="modal-car-price">R$ ${car.price}<small>${t('card.per_day')}</small></div>
  `;

  updatePriceSummary();
  document.getElementById('modalOverlay').classList.add('open');
  document.body.style.overflow='hidden';

  ['fPickup','fReturn','optGPS','optSeat','optInsurance'].forEach(id=>{
    document.getElementById(id)?.addEventListener('change', updatePriceSummary);
  });
}

function updatePriceSummary(){
  if(!currentCar) return;
  const p = document.getElementById('fPickup').value;
  const r = document.getElementById('fReturn').value;
  let days = 1;
  if(p && r){ days = Math.max(1,Math.round((new Date(r)-new Date(p))/86400000)); }
  const sub = currentCar.price * days;
  let extras = 0;
  if(document.getElementById('optGPS')?.checked)       extras += 15*days;
  if(document.getElementById('optSeat')?.checked)      extras += 12*days;
  if(document.getElementById('optInsurance')?.checked) extras += 35*days;
  const total = sub + extras;
  document.getElementById('priceSummary').innerHTML = `
    <div class="price-row"><span>${t('price.days')}</span><span>${days}× R$ ${currentCar.price}</span></div>
    <div class="price-row"><span>${t('price.subtotal')}</span><span>R$ ${sub.toLocaleString('pt-BR')}</span></div>
    ${extras>0?`<div class="price-row"><span>${t('price.extras')}</span><span>R$ ${extras.toLocaleString('pt-BR')}</span></div>`:''}
    <div class="price-row"><span>${t('price.total')}</span><span>R$ ${total.toLocaleString('pt-BR')}</span></div>
  `;
}

function closeModal(){
  document.getElementById('modalOverlay').classList.remove('open');
  document.body.style.overflow='';
}
function closeModalOut(e){ if(e.target===document.getElementById('modalOverlay')) closeModal(); }

function confirmReservation(){
  const name  = document.getElementById('fName').value.trim();
  const phone = document.getElementById('fPhone').value.trim();
  const email = document.getElementById('fEmail').value.trim();
  const pickup= document.getElementById('fPickup').value;
  const ret   = document.getElementById('fReturn').value;
  if(!name||!phone||!email||!pickup||!ret){ showToast('⚠️ Preencha todos os campos obrigatórios.'); return; }
  closeModal();
  showToast(t('toast.reserve'));
}

/* ─── SEARCH ─── */
function doSearch(){
  const cat = document.getElementById('barCategory').value;
  const p   = document.getElementById('barPickup').value;
  const r   = document.getElementById('barReturn').value;
  showToast(t('toast.search'));
  if(cat){
    currentFilter = cat;
    document.querySelectorAll('.filter-btn').forEach(b=>{
      const matches = b.dataset.cat === cat || (cat && b.textContent.toLowerCase().includes(cat));
      b.classList.toggle('active', b.onclick?.toString().includes(`'${cat}'`));
    });
  }
  document.getElementById('fleet').scrollIntoView({behavior:'smooth'});
  setTimeout(renderFleet, 400);
}

/* ─── TOAST ─── */
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 3800);
}

/* ─── NAVBAR ─── */
window.addEventListener('scroll',()=>{
  document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 60);
});

/* ─── REVEAL ─── */
function observeReveal(){
  const obs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); } });
  },{threshold:.1});
  document.querySelectorAll('.reveal:not(.visible)').forEach(el=>obs.observe(el));
}

/* ─── DATE DEFAULTS ─── */
function setDefaultDates(){
  const today    = new Date().toISOString().split('T')[0];
  const tomorrow = new Date(Date.now()+86400000).toISOString().split('T')[0];
  document.getElementById('barPickup').min = today;
  document.getElementById('barPickup').value= today;
  document.getElementById('barReturn').min  = tomorrow;
  document.getElementById('barReturn').value= tomorrow;
}

/* ─── INIT ─── */
setDefaultDates();
renderFleet();
renderReviews();
observeReveal();
